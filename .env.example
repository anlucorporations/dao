# Ejemplo de variables de entorno (NO subir credenciales reales)
# Rellena esto en tu Cospace/Secrets manager o en un archivo .env local que no se suba.

# PostgreSQL
POSTGRES_USER=anlucorporations
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_DB=cooperativa_cappones
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Anvil / RPC
NEXT_PUBLIC_ANVIL_RPC=http://anvil:8545
NEXT_PUBLIC_ANVIL_RPC_URL=http://anvil:8545
ANVIL_MNEMONIC=test test test test test test test test test test test junk

# JWT / Auth
JWT_SECRET=REPLACE_WITH_SECRET

# Prisma (opcional)
# PRISMA_SCHEMA_PATH=./web/prisma/schema.prisma
